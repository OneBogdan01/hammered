---
Checks: >
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  readability-*,
  modernize-*,
  cppcoreguidelines-*,
  cert-*,
  concurrency-*,
  misc-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-uppercase-literal-suffix,
  -misc-non-private-member-variables-in-classes,
  -misc-unused-parameters

# RUST-LIKE SAFETY CHECKS - CRITICAL
# These are like Rust's borrow checker - NEVER disable these
WarningsAsErrors: >
  bugprone-use-after-move,
  bugprone-dangling-handle,
  bugprone-parent-virtual-call,
  bugprone-undefined-memory-manipulation,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-slicing,
  cert-err58-cpp,
  cert-err60-cpp,
  misc-misplaced-const,
  performance-move-const-arg,
  performance-no-automatic-move

CheckOptions:
  # ============================================================================
  # RUST NAMING CONVENTIONS
  # ============================================================================
  
  # Namespaces: snake_case (like Rust modules: std::io, std::collections)
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  
  # Types: PascalCase (like Rust: String, Vec, HashMap)
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  
  - key: readability-identifier-naming.UnionCase
    value: CamelCase
  
  # Functions/Methods: snake_case (like Rust: push_back, to_string, from_iter)
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  
  # Variables: snake_case (like Rust: my_variable, frame_count)
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case
  
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  
  # Members: snake_case (Rust doesn't use prefixes)
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  
  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case
  
  # Constants: SCREAMING_SNAKE_CASE (like Rust: MAX_SIZE, DEFAULT_CAPACITY)
  - key: readability-identifier-naming.ConstantCase
    value: UPPER_CASE
  
  - key: readability-identifier-naming.ConstexprVariableCase
    value: UPPER_CASE
  
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE
  
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  
  # Macros: SCREAMING_SNAKE_CASE with prefix
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  
  - key: readability-identifier-naming.MacroDefinitionPrefix
    value: HM_
  
  # Template parameters: PascalCase single letter (like Rust: T, K, V)
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  
  # ============================================================================
  # RUST-LIKE SAFETY SETTINGS
  # ============================================================================
  
  # Enforce RAII and proper initialization (like Rust's guaranteed initialization)
  - key: cppcoreguidelines-pro-type-member-init.IgnoreArrays
    value: false
  
  - key: cppcoreguidelines-pro-type-member-init.UseAssignment
    value: false
  
  # Enforce modern C++ practices (like Rust's modern defaults)
  - key: modernize-use-override.IgnoreDestructors
    value: false
  
  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'
  
  # Memory safety - prefer smart pointers (like Rust's Box, Rc, Arc)
  - key: modernize-make-unique.MakeSmartPtrFunction
    value: 'std::make_unique'
  
  - key: modernize-make-shared.MakeSmartPtrFunction
    value: 'std::make_shared'
  
  # Enforce const correctness (like Rust's immutability by default)
  - key: readability-const-return-type.IgnoreMacros
    value: false
  
  - key: misc-const-correctness.AnalyzeValues
    value: true
  
  - key: misc-const-correctness.AnalyzeReferences
    value: true
  
  - key: misc-const-correctness.WarnPointersAsValues
    value: true
  
  # Function complexity limits (like Rust's preference for small functions)
  - key: readability-function-cognitive-complexity.Threshold
    value: 25
  
  - key: readability-function-size.LineThreshold
    value: 80
  
  - key: readability-function-size.StatementThreshold
    value: 50
  
  # Avoid implicit conversions (like Rust's explicit From/Into traits)
  - key: bugprone-implicit-widening-of-multiplication-result.UseCXXStaticCastsInCppSources
    value: true
  
  # Performance settings (like Rust's zero-cost abstractions)
  - key: performance-unnecessary-copy-initialization.AllowedTypes
    value: ''
  
  - key: performance-for-range-copy.WarnOnAllAutoCopies
    value: true
  
  - key: performance-move-const-arg.CheckTriviallyCopyableMove
    value: true

HeaderFilterRegex: '^((?!external|build|\.cache).)*$'
FormatStyle: file